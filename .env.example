# PostgreSQL is optional during interface development. Without it, the app uses
# the clearly labelled in-memory demo adapter.
DATABASE_URL="postgresql://chemcider:change-me@localhost:5432/chemcider_labs?schema=public"

# Generate at least 32 random bytes for every deployed environment.
AUTH_SECRET="replace-with-a-long-random-secret"

# Local development only. Never enable this on a public deployment.
CHEMCIDER_DEMO_AUTH="true"

# Optional local development path for immutable quarantine and normalized files.
# Leave empty to use .data/object-store inside this project.
LOCAL_OBJECT_STORAGE_ROOT=""

# Private S3-compatible storage required before production deployment.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="af-south-1"
OBJECT_STORAGE_BUCKET="chemcider-labs-private"
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""